# --- Ring (required) ---
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_KEY=                 # used for webhook signature verification (hex) and nonce (base64url)
RING_SANDBOX_TOKEN=            # temporary OAuth token from Ring Developer Playground (regenerate when expired)
RING_API_BASE=https://api.amazonvision.com
RING_OAUTH_BASE=https://oauth.ring.com

# --- AWS (required for AWS Builder mini-challenge) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_FAST=amazon.nova-lite-v1:0          # Stage 3 tier 1 (cheap vision)
BEDROCK_MODEL_STRONG=                            # Stage 3 tier 2 (Claude Sonnet-class vision on Bedrock; use the ID available in the region)
BEDROCK_GUARDRAIL_ID=                            # optional; if empty, use the local guardrail only
POLLY_VOICE_EN=Joanna
POLLY_VOICE_HI=Kajal
USE_REKOGNITION=true                             # Stage 1 object gate via Rekognition DetectLabels

# --- Fallback / alternative providers (optional; use only if AWS key missing or a call fails) ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=                                  # Indian-language TTS/STT (Hindi, Bengali)
FISH_AUDIO_API_KEY=
DEEPSEEK_API_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000
PUBLIC_WEBHOOK_URL=                              # ngrok/VPS https URL that forwards to /api/ring/webhook
DEFAULT_LANGUAGE=en
DEMO_MODE=true                                   # shows the "Simulate event" panel in the UI

# --- Optional extras (defaults shown; leave unset unless you need them) ---
# Comma-separated values in any *_API_KEY rotate round-robin.
# RING_REFRESH_TOKEN=                            # production: refresh-token grant instead of the sandbox token
# BEDROCK_MODEL_JUDGE=amazon.nova-micro-v1:0     # guardrail layer 3 classifier when no BEDROCK_GUARDRAIL_ID
# BEDROCK_GUARDRAIL_VERSION=DRAFT
# POLLY_VOICE_ES=Lupe
# S3_BUCKET=                                     # corrections dataset export target; local folder if empty
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
# OPENAI_VISION_MODEL=gpt-4o-mini
# SARVAM_SPEAKER=priya
# FFMPEG_PATH=ffmpeg
# FALLBACK_ALERT_LOG=                            # where OpenRouter fallback alerts are appended
