{
  "name": "doorvoice",
  "version": "0.1.0",
  "private": true,
  "description": "DoorVoice: a spoken, safety-checked guide to what is at your Ring door, for blind, low-vision, deaf and caregiving users.",
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "predev": "node scripts/setup.mjs",
    "dev": "next dev -p 3000",
    "prebuild": "node scripts/setup.mjs",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "a11y": "node scripts/a11y-check.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-polly": "^3.700.0",
    "@aws-sdk/client-rekognition": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-transcribe-streaming": "^3.700.0",
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "^0.460.0",
    "next": "15.5.18",
    "p-queue": "^8.1.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "sharp": "^0.34.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "20.10.6",
    "@types/react": "18.2.46",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "10.4.16",
    "axe-core": "^4.10.2",
    "playwright-core": "^1.48.2",
    "postcss": "8.5.10",
    "prisma": "^6.19.0",
    "tailwindcss": "3.4.0",
    "typescript": "5.3.3",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  }
}
